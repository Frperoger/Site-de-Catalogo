# URL do projeto em Supabase > Project Settings > API.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave publishable (sb_publishable_...) ou anon pública do MESMO projeto.
# Esta chave também é usada no navegador. NUNCA informe service_role/secret aqui.
SUPABASE_ANON_KEY=SUA-CHAVE-PUBLICA

PORT=3000
HOST=0.0.0.0
